# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
# Defina a URL pública ao executar o build em produção (sem /api/auth).
# AUTH_URL="https://trilha.example.com"

# Google OAuth (aplicativo Web)
# URI de redirecionamento local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Painel de métricas. Em produção, defina uma senha exclusiva de 16+ caracteres.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adimininasto"
# Defina como false para pausar novas medições.
ANALYTICS_ENABLED="true"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Credenciais locais usadas pelo compose.yaml. Mantenha-as alinhadas à DATABASE_URL.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="trilha-imd"
DATABASE_URL="postgresql://postgres:password@localhost:5432/trilha-imd"

# Somente desenvolvimento, origem e PostgreSQL locais; nunca habilita em produção.
TRILBIT_LOCAL_LOGIN="false"
