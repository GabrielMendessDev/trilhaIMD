                "id": "formula-central",
                "tipo": "formula",
                "leitura": "Uma potência de expoente negativo é o recíproco da potência correspondente; a base não pode ser zero.",
                "termos": [
                  {
                    "forma": "texto",
                    "valor": "a⁻ⁿ=1/aⁿ, a≠0"
                  }
                ]
              }
            ],
            "titulo": "Dar nome às ideias",
            "categoria": "explicacao"
          }
        },
