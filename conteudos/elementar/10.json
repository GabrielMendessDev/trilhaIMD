                "texto": "16"
              },
              {
                "id": "b",
                "texto": "3"
              },
              {
                "id": "c",
                "texto": "5"
              }
            ],
            "gabarito": "c"
          }
        },
        {
          "numero": 4,
          "ordem": 4,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Se u=logₐx e v=logₐy, então x=aᵘ e y=aᵛ. Logo xy=aᵘ⁺ᵛ. A unicidade do expoente dá logₐ(xy)=u+v. Essa demonstração também mostra por que não existe uma regra semelhante para x+y: somar potências não soma expoentes. A base 1 falha porque 1ᶜ não distingue expoentes."
              },
              {
                "id": "roteiro",
                "tipo": "diagrama",
                "legenda": "Roteiro de leitura: objetivo e teste de consistência.",
                "dados": {
                  "modelo": "quadro",
                  "linhas": [
                    {
                      "simbolo": "Objetivo",
                      "leitura": "Justificar propriedades logarítmicas a partir de potências.",
                      "exemplo": "Calcule log₂(8·√2). Escreva 8=2³ e √2=2^(1/2)."
                    },
                    {
                      "simbolo": "Conferência",
                      "leitura": "Volte às condições da expressão original.",
                      "exemplo": "Pelas propriedades, log₂8+log₂√2=3+1/2=7/2. Os dois caminhos concordam e todos os argumentos são positivos."
                    }
                  ]
                }
              }
            ],
            "titulo": "Por que isso funciona?",
            "categoria": "explicacao"
          }
        },
