            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Uma equipe descreve o custo fictício de um projeto por 2x²+3x+5. Outra escreve 5+3x+2x². As duas planilhas estão discutindo a mesma coisa com a mobília em outra ordem. Vamos descobrir a estrutura que permanece."
              },
              {
                "id": "texto-2",
                "tipo": "texto",
                "texto": "Ao concluir: Identificar coeficientes, termos e grau de um polinômio."
              },
              {
                "id": "texto-3",
                "tipo": "texto",
                "texto": "Para começar: Potências inteiras e expressões algébricas da Unidade 1."
              }
            ],
            "titulo": "Polinômios: uma expressão com estrutura",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 2,
          "ordem": 2,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Um polinômio real em x é uma soma finita aₙxⁿ+…+a₁x+a₀, com expoentes inteiros não negativos e coeficientes reais. Se aₙ≠0, seu grau é n e aₙ é o coeficiente líder. Termos ausentes têm coeficiente zero. O polinômio nulo tem todos os coeficientes zero; seu grau fica indefinido nesta trilha."
              },
              {
                "id": "formula-central",
                "tipo": "formula",
                "leitura": "Um polinômio é uma soma finita de coeficientes reais multiplicando potências inteiras não negativas.",
                "termos": [
                  {
                    "forma": "texto",
                    "valor": "P(x)=aₙxⁿ+⋯+a₀"
                  }
                ]
              }
            ],
            "titulo": "Dar nome às ideias",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 3,
          "ordem": 3,
          "modo": "questao",
          "questao": {
            "enunciado": "Qual é o grau de 5−2x³+x?",
