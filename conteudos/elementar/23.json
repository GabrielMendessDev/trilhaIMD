    {
      "id": "elementar-v2-passo-23",
      "titulo": "Produtos notáveis sem feitiçaria",
      "questoes": [
        {
          "numero": 1,
          "ordem": 1,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Um quadrado de lado a+b pode ser dividido em quatro peças. Duas delas são retângulos iguais. É justamente uma dessas peças que costuma desaparecer quando alguém escreve (a+b)²=a²+b². A geometria pode chamar a peça de volta."
              },
              {
                "id": "texto-2",
                "tipo": "texto",
                "texto": "Ao concluir: Demonstrar quadrados de binômios e diferença de quadrados."
              },
              {
                "id": "texto-3",
                "tipo": "texto",
                "texto": "Para começar: Distributividade e multiplicação de polinômios."
              }
            ],
            "titulo": "Produtos notáveis sem feitiçaria",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 2,
          "ordem": 2,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "As identidades são (a+b)²=a²+2ab+b², (a−b)²=a²−2ab+b² e (a+b)(a−b)=a²−b². Valem para reais a,b e também para expressões polinomiais substituídas em seus lugares. O sinal do termo central depende do produto dos dois termos do binômio."
              },
              {
                "id": "formula-central",
                "tipo": "formula",
                "leitura": "O quadrado de uma soma tem dois quadrados e o termo central duas vezes a vezes b.",
                "termos": [
                  {
                    "forma": "texto",
                    "valor": "(a+b)²=a²+2ab+b²"
                  }
                ]
              }
            ],
            "titulo": "Dar nome às ideias",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 3,
          "ordem": 3,
          "modo": "questao",
          "questao": {
            "enunciado": "Qual é (x+3)²?",
            "assunto": "Produtos notáveis sem feitiçaria",
            "orientacao": "Expanda pela distributiva para conferir o termo central, especialmente quando houver um sinal de menos.",
            "explicacao": "O termo central é 2·x·3=6x.",
            "essencial": false,
            "tipo": "multipla-escolha",
            "alternativas": [
              {
                "id": "a",
                "texto": "x²+3x+9"
              },
              {
                "id": "b",
                "texto": "x²+6x+9"
              },
              {
                "id": "c",
                "texto": "x²+9"
              }
            ],
            "gabarito": "b"
          }
        },
        {
          "numero": 4,
          "ordem": 4,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Expanda (a+b)(a+b): aparecem a², ab, ba e b². Como ab=ba em ℝ, os dois termos centrais somam 2ab. Na diferença de quadrados, −ab e +ab se cancelam. O desenho por áreas é intuitivo para medidas positivas; a distributiva demonstra as identidades para todos os reais."
              },
              {
                "id": "roteiro",
                "tipo": "diagrama",
                "legenda": "Roteiro de leitura: objetivo e teste de consistência.",
                "dados": {
                  "modelo": "quadro",
                  "linhas": [
                    {
                      "simbolo": "Objetivo",
                      "leitura": "Demonstrar quadrados de binômios e diferença de quadrados.",
                      "exemplo": "Expanda (2x−3)². Identifique a=2x e b=3."
                    },
                    {
                      "simbolo": "Conferência",
                      "leitura": "Volte às condições da expressão original.",
                      "exemplo": "Logo (2x−3)²=4x²−12x+9. Em x=0, ambos os lados valem 9; em x=1, ambos valem 1."
                    }
                  ]
                }
              }
            ],
            "titulo": "Por que isso funciona?",
            "categoria": "explicacao"
          }
        },
