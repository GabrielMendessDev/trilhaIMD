                "blocos": [
                  {
                    "id": "exemplo-1",
                    "tipo": "texto",
                    "texto": "Converta 150°: 150·π/180=5π/6 rad. É menor que π e maior que π/2, logo termina no segundo quadrante."
                  }
                ]
              },
              {
                "id": "passo-2",
                "titulo": "Desenvolver o raciocínio",
                "blocos": [
                  {
                    "id": "exemplo-2",
                    "tipo": "texto",
                    "texto": "Converta −π/3 rad: −π/3·180/π=−60°. A rotação é horária."
                  }
                ]
              },
              {
                "id": "passo-3",
                "titulo": "Concluir e conferir",
                "blocos": [
                  {
                    "id": "exemplo-3",
                    "tipo": "texto",
                    "texto": "Somando uma volta a −π/3, obtemos 5π/3, que termina no mesmo ponto. Os ângulos são coterminais, não a mesma medida orientada."
                  }
                ]
              }
            ]
