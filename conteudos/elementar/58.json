          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Em 2×2, ad−bc mede a área orientada do paralelogramo das colunas: zero indica direções dependentes. A fórmula pode ser demonstrada decompondo a área ou usando base×altura com coordenadas. Em 3×3, os seis termos da expressão definem a regra usada; Sarrus apenas os organiza, sem criar novos produtos. Propriedades gerais e cofatores não são prioridade da P3 2025.2 conforme o acervo."
              },
              {
                "id": "roteiro",
                "tipo": "diagrama",
                "legenda": "Roteiro de leitura: objetivo e teste de consistência.",
                "dados": {
                  "modelo": "quadro",
                  "linhas": [
                    {
                      "simbolo": "Objetivo",
                      "leitura": "Calcular determinantes por fórmulas diretas e regra de Sarrus.",
                      "exemplo": "Calcule detA para A=[[1,2,0],[0,3,1],[2,0,1]]. Os produtos somados são 1·3·1=3, 2·1·2=4 e 0·0·0=0."
                    },
                    {
                      "simbolo": "Conferência",
                      "leitura": "Volte às condições da expressão original.",
                      "exemplo": "Portanto detA=3+4+0−0−0−0=7. Para B=[[2,1],[3,4]], detB=2·4−1·3=5."
                    }
                  ]
                }
              }
            ],
            "titulo": "Por que isso funciona?",
            "categoria": "explicacao"
          }
