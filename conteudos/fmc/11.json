    {
      "id": "fmc-v1-passo-11",
      "titulo": "Inversos e equações modulares",
      "questoes": [
        {
          "numero": 1,
          "ordem": 1,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Na aritmética usual, dividir por 3 resolve 3x=1 nos racionais. Em módulo 7, a tarefa é outra: encontrar um inteiro cujo produto por 3 deixe resto 1."
              },
              {
                "id": "texto-2",
                "tipo": "texto",
                "texto": "Ao concluir: Decidir se há inverso e resolver congruências lineares."
              },
              {
                "id": "texto-3",
                "tipo": "texto",
                "texto": "Para começar: Congruências, MDC e identidade de Bézout."
              }
            ],
            "titulo": "Inversos e equações modulares",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 2,
          "ordem": 2,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Um inverso de a módulo m é um inteiro u com au≡1 (mod m). Ele existe exatamente quando mdc(a,m)=1. Bézout fornece u ao escrever 1=ua+vm. A congruência ax≡b (mod m) tem solução se e somente se d=mdc(a,m) divide b; quando tem, possui d classes de soluções módulo m. Se a é invertível, multiplicar por seu inverso produz a única classe de solução."
              },
              {
                "id": "formula-central",
                "tipo": "formula",
                "leitura": "Decidir se há inverso e resolver congruências lineares.",
                "termos": [
                  {
                    "forma": "texto",
                    "valor": "ax≡b tem solução ⇔ mdc(a,m)∣b"
                  }
                ]
              }
            ],
            "titulo": "Dar nome às ideias",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 3,
          "ordem": 3,
          "modo": "questao",
          "questao": {
            "enunciado": "Qual é um inverso de 3 módulo 7?",
            "assunto": "Inversos e equações modulares",
            "orientacao": "Retome a definição e as condições do problema. Decidir se há inverso e resolver congruências lineares.",
            "explicacao": "3·5=15≡1 (mod 7).",
            "essencial": false,
            "tipo": "multipla-escolha",
            "alternativas": [
              {
                "id": "a",
                "texto": "2."
              },
              {
                "id": "b",
                "texto": "5."
              },
              {
                "id": "c",
                "texto": "3."
              }
            ],
            "gabarito": "b"
          }
        },
        {
          "numero": 4,
          "ordem": 4,
          "modo": "conteudo",
          "conteudo": {
            "blocos": [
              {
                "id": "texto-1",
                "tipo": "texto",
                "texto": "Se ax−my=b, todo divisor comum de a e m precisa dividir b, mostrando a condição necessária. Quando d divide b, uma identidade de Bézout para d pode ser multiplicada por b/d para produzir uma solução. As demais aparecem em intervalos de m/d dentro de um sistema de resíduos módulo m."
              }
            ],
            "titulo": "Por que isso funciona?",
            "categoria": "explicacao"
          }
        },
        {
          "numero": 5,
          "ordem": 5,
          "modo": "questao",
          "questao": {
            "enunciado": "O número 2 possui inverso módulo 6?",
            "assunto": "Inversos e equações modulares",
            "orientacao": "Retome a definição e as condições do problema. Decidir se há inverso e resolver congruências lineares.",
            "explicacao": "Só as classes coprimas ao módulo possuem inverso.",
            "essencial": false,
            "tipo": "multipla-escolha",
            "alternativas": [
              {
                "id": "a",
                "texto": "Não, pois mdc(2,6)=2."
              },
              {
                "id": "b",
                "texto": "Sim, o inverso é 3."
              },
              {
                "id": "c",
                "texto": "Sim, todo número diferente de zero tem inverso."
              }
            ],
            "gabarito": "a"
          }
        },
        {
          "numero": 6,
          "ordem": 6,
          "modo": "questao",
          "questao": {
            "enunciado": "Exemplo guiado · Inversos e equações modulares",
            "assunto": "Inversos e equações modulares",
            "tipo": "passo-a-passo",
            "passos": [
              {
                "id": "passo-1",
                "titulo": "Organizar as informações",
                "blocos": [
                  {
                    "id": "exemplo-1",
                    "tipo": "texto",
                    "texto": "Resolva 6x≡8 (mod 14). Temos mdc(6,14)=2, que divide 8; há duas classes módulo 14."
                  }
                ]
              },
              {
                "id": "passo-2",
                "titulo": "Desenvolver o raciocínio",
                "blocos": [
                  {
                    "id": "exemplo-2",
                    "tipo": "texto",
                    "texto": "Divida coeficientes e módulo por 2: 3x≡4 (mod 7). Como o inverso de 3 módulo 7 é 5, x≡20≡6 (mod 7)."
                  }
                ]
              },
              {
                "id": "passo-3",
                "titulo": "Concluir e conferir",
                "blocos": [
                  {
                    "id": "exemplo-3",
                    "tipo": "texto",
                    "texto": "Em {0,…,13}, as soluções são 6 e 13. Confira: 6·6−8=28 e 6·13−8=70, ambos múltiplos de 14."
                  }
                ]
              }
            ]
          }
