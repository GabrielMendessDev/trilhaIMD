// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  meExams              MeExamAttempt[]
  id                   String                  @id @default(cuid())
  name                 String?
  email                String?                 @unique
  emailVerified        DateTime?
  image                String?
  accounts             Account[]
  sessions             Session[]
  posts                Post[]
  learningProgress     LearningPointProgress[]
  rpgWallet            RpgWallet?
  rpgEvents            RpgEvent[]
  currencyTransactions CurrencyTransaction[]
  achievements         UserAchievement[]
  achievementProgress  AchievementProgress[]
  inventory            InventoryItem[]
  itemUsages           ItemUsage[]
  questionStates       RpgQuestionState[]
  protections          UserStreakProtection[]
  materialReadings     MaterialReading[]
  studyDays            StudyDay[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LearningEntryMode {
  CONTENT
  QUESTION
  MIXED
}

enum LearningQuestionType {
  MULTIPLE_CHOICE
  ASSOCIATION
  PAIR_LINKS
  WALKTHROUGH
}

model LearningTrail {
  slug     String       @id
  name     String
  archived Boolean      @default(false)
  points   TrailPoint[]
}

model LearningCatalogRevision {
  id      Int    @id
  version BigInt @default(0)
}

model TrailPoint {
  id               Int                     @id @default(autoincrement())
  trailSlug        String
  number           Int
  trail            LearningTrail           @relation(fields: [trailSlug], references: [slug], onDelete: Restrict)
  content          TrailPointContent?
  activities       LearningActivity[]
  xpReward         Int                     @default(10)
  progress         LearningPointProgress[]
  rpgQuestions     RpgQuestionState[]
  materialReadings MaterialReading[]

  @@unique([trailSlug, number])
}

model LearningPointProgress {
  userId           String
  pointId          Int
  completedEntries String[]   @default([])
  attempts         Json       @default("{}") @db.JsonB
  skippedEntries   String[]   @default([])
  deferredEntries  String[]   @default([])
  completedAt      DateTime?  @db.Timestamptz(3)
  xp               Int        @default(0)
  correctAnswers   Int        @default(0)
  lives            Int        @default(5)
  run              Int        @default(1)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  point            TrailPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@id([userId, pointId])
  @@index([pointId])
}

model TrailPointContent {
  pointId Int        @id
  blocks  Json       @db.JsonB
  summary String?
  point   TrailPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
}

model LearningActivity {
  id      Int             @id @default(autoincrement())
  pointId Int
  slug    String
  title   String
  point   TrailPoint      @relation(fields: [pointId], references: [id], onDelete: Cascade)
  entries LearningEntry[]

  @@unique([pointId, slug])
}

model LearningEntry {
  activityId Int
  number     Int
  position   Int?
  mode       LearningEntryMode
  type       LearningQuestionType?
  prompt     String?
  media      Json?                 @db.JsonB
  payload    Json?                 @db.JsonB
  answer     Json?                 @db.JsonB
  content    Json?                 @db.JsonB
  activity   LearningActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([activityId, number])
}

model RpgWallet {
  userId        String  @id
  bits          Int     @default(0)
  achievementXp Int     @default(0)
  rewardedLevel Int     @default(0)
  stats         Json    @default("{}") @db.JsonB
  initialized   Boolean @default(false)
  settledDay    String?
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AchievementDefinition {
  id         String                @id
  definition Json                  @db.JsonB
  users      UserAchievement[]
  progress   AchievementProgress[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime              @default(now()) @db.Timestamptz(3)
  xp            Int
  bits          Int
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition    AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@id([userId, achievementId])
}

model AchievementProgress {
  userId        String
  achievementId String
  current       Int                   @default(0)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition    AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@id([userId, achievementId])
}

model RpgEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  type      String
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt])
}

model CurrencyTransaction {
  id           Int      @id @default(autoincrement())
  userId       String
  key          String
  kind         String
  subject      String
  bits         Int
  xp           Int
  balanceAfter Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, id])
}

model ShopItem {
  id         String          @id
  definition Json            @db.JsonB
  inventory  InventoryItem[]
}

model InventoryItem {
  userId   String
  itemId   String
  quantity Int      @default(0)
  equipped Boolean  @default(false)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     ShopItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([userId, itemId])
}

model ItemUsage {
  id        Int      @id @default(autoincrement())
  userId    String
  requestId String
  itemId    String
  pointId   Int?
  entryKey  String?
  action    String
  result    Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, id])
}

model RpgQuestionState {
  userId   String
  pointId  Int
  entryKey String
  effects  Json       @default("{}") @db.JsonB
  assisted Boolean    @default(false)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  point    TrailPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@id([userId, pointId, entryKey])
}

model UserStreakProtection {
  id           Int      @id @default(autoincrement())
  userId       String
  activatedDay String
  protectedDay String?
  state        String   @default("armed")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
}

model StudyDay {
  userId String
  day    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model MaterialReading {
  userId      String
  pointId     Int
  entryKey    String
  startedAt   DateTime   @default(now()) @db.Timestamptz(3)
  completedAt DateTime?  @db.Timestamptz(3)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  point       TrailPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@id([userId, pointId, entryKey])
}

model MeExamAttempt {
  trail       String    @default("elementar")
  unit        Int       @default(1)
  id          String    @id
  userId      String
  version     Int       @default(1)
  questions   Json      @db.JsonB
  answers     Json      @default("{}") @db.JsonB
  revision    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  submittedAt DateTime? @db.Timestamptz(3)
  score       Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, unit, createdAt])
  @@index([userId, trail, unit, createdAt])
}

model AnalyticsSession {
  id        String   @id @db.Uuid
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeen  DateTime @db.Timestamptz(3)
  sequence  Int
  activeMs  Int
  screen    String
  device    String
  viewport  String

  @@index([startedAt])
}

model AnalyticsDaily {
  day   String
  kind  String
  label String
  count Int    @default(0)
  total BigInt @default(0)

  @@id([day, kind, label])
}

model AdminCredential {
  id           Int    @id @default(1)
  username     String
  salt         String
  passwordHash String
}
