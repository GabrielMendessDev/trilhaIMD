{"nodes": [{"id": "conteudos_readme_banco_de_conteudos_e_atividades", "label": "Banco de conte\u00fados e atividades", "file_type": "document", "source_file": "conteudos/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "conteudos_readme_json_por_ponto", "label": "JSON por ponto", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L3-L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Um arquivo UTF-8 identifica vers\u00e3o, trilha e ponto, com conte\u00fado avulso opcional e atividades identificadas contendo entradas numeradas."}, {"id": "conteudos_readme_tipos_de_questao", "label": "Tipos de quest\u00e3o", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L21-L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Os quatro tipos s\u00e3o m\u00faltipla escolha, associa\u00e7\u00e3o, liga\u00e7\u00e3o e passo a passo. Liga\u00e7\u00e3o limita cada destino a um \u00fanico uso."}, {"id": "conteudos_readme_validacao_de_atividades", "label": "Valida\u00e7\u00e3o de atividades", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L49-L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Valida formato, n\u00fameros, IDs, refer\u00eancias do gabarito e o m\u00ednimo de dez entradas quest\u00e3o ou mista por atividade, sem conex\u00e3o com o banco."}, {"id": "conteudos_readme_importacao_transacional", "label": "Importa\u00e7\u00e3o transacional", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L58-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A valida\u00e7\u00e3o precede a transa\u00e7\u00e3o. Reimportar uma atividade substitui suas quest\u00f5es, preservando atividades e conte\u00fado avulso que o arquivo omite."}, {"id": "conteudos_readme_postgresql", "label": "PostgreSQL", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persiste trilhas, pontos, atividades e entradas. Alternativas, recursos e blocos usam JSONB. O gabarito fica separado dos dados de apresenta\u00e7\u00e3o, e o m\u00ednimo de dez quest\u00f5es \u00e9 conferido no commit."}, {"id": "conteudos_readme_publicacao_de_etapas", "label": "Publica\u00e7\u00e3o de etapas", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pontos com conte\u00fado ou atividade importada entram no percurso, etapas publicadas abrem em ordem e outros pontos continuam dispon\u00edveis como pr\u00e9vias."}, {"id": "conteudos_readme_primeira_conclusao", "label": "Primeira conclus\u00e3o", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A primeira conclus\u00e3o registrada credita o valor configurado em TrailPoint.xpReward, inicialmente 10 XP. O servidor confere o gabarito."}, {"id": "conteudos_readme_ofensiva", "label": "Ofensiva em America/Sao_Paulo", "file_type": "concept", "source_file": "conteudos/README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada dia com pelo menos uma etapa conclu\u00edda conta como um dia no fuso America/Sao_Paulo."}], "edges": [{"source": "conteudos_readme_banco_de_conteudos_e_atividades", "target": "conteudos_readme_json_por_ponto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "conteudos/README.md", "source_location": "L3-L11", "weight": 1}, {"source": "conteudos_readme_json_por_po