{
	"name": "trilha-imd",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"test": "node --test tests/*.test.mjs",
		"verify": "npm run check && npm run typecheck && npm test && npm run conteudo:validar:elementar && npm run conteudo:validar:fmc",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"conteudo:validar": "node scripts/conteudo.mjs validar",
		"conteudo:gerar:elementar": "node scripts/gerar-elementar.mjs",
		"conteudo:validar:elementar": "node scripts/publicar-elementar.mjs",
		"conteudo:publicar:elementar": "node scripts/publicar-elementar.mjs --importar",
		"test:elementar": "node --test tests/elementar.test.mjs",
		"test:elementar:browser": "node --test tests/elementar-browser.mjs",
		"test:vidas": "node --test tests/vidas.test.mjs",
		"test:vidas:local": "node scripts/testar-vidas-local.mjs",
		"conteudo:importar": "node scripts/conteudo.mjs importar",
		"test:aprendizagem": "node --test tests/aprendizagem.test.mjs",
		"test:aprendizagem:http": "node --test tests/aprendizagem-http.mjs",
		"test:feedback": "node --test tests/feedback.test.mjs",
		"test:feedback:browser": "node --test tests/feedback-browser.mjs",
		"test:rpg": "node --test tests/rpg.test.mjs",
		"test:rpg:http": "node --test tests/rpg-http.mjs",
		"test:rpg:browser": "node --test tests/rpg-browser.mjs",
		"test:items": "node --test tests/item-policy.test.mjs",
		"test:items:http": "node --test tests/items-availability-http.mjs",
		"test:items:browser": "node --test tests/items-checkpoint-browser.mjs",
		"test:experience:browser": "node --test tests/global-experience-browser.mjs",
		"dev": "next dev --turbo",
		"postinstall": "prisma generate",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"test:prova": "node --test tests/me-exam.test.mjs tests/me-exam-units.test.mjs",
		"test:prova:http": "node --test tests/me-exam-http.mjs",
		"test:prova:browser": "node --test tests/me-exam-browser.mjs",
		"conteudo:gerar:fmc": "node scripts/gerar-fmc.mjs",
		"conteudo:validar:fmc": "node scripts/publicar-fmc.mjs",
		"conteudo:publicar:fmc": "node scripts/publicar-fmc.mjs --importar",
		"test:fmc": "node --test tests/fmc.test.mjs",
		"test:fmc:http": "node --test tests/fmc-http.mjs tests/fmc-learning-http.mjs",
		"test:fmc:browser": "node --test tests/fmc-browser.mjs"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.7.2",
		"@prisma/adapter-pg": "6.12.0",
		"@prisma/client": "6.12.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"next": "^15.5.29",
		"next-auth": "5.0.0-beta.32",
		"pg": "8.16.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^20.14.10",
		"@types/pg": "8.15.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"postcss": "^8.5.3",
		"prisma": "6.12.0",
		"tailwindcss": "^4.0.15",
		"typescript": "^5.8.2"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "npm@11.11.0",
	"overrides": {
		"next": {
			"postcss": "^8.5.28"
		}
	}
}
