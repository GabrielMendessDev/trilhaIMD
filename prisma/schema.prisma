// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    posts         Post[]
    learningProgress LearningPointProgress[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

enum LearningEntryMode {
    CONTENT
    QUESTION
    MIXED
}

enum LearningQuestionType {
    MULTIPLE_CHOICE
    ASSOCIATION
    PAIR_LINKS
    WALKTHROUGH
}

model LearningTrail {
    slug   String       @id
    name   String
    points TrailPoint[]
}

model TrailPoint {
    id         Int                @id @default(autoincrement())
    trailSlug  String
    number     Int
    trail      LearningTrail      @relation(fields: [trailSlug], references: [slug], onDelete: Restrict)
    content    TrailPointContent?
    activities LearningActivity[]
    xpReward   Int                @default(10)
    progress   LearningPointProgress[]

    @@unique([trailSlug, number])
}

model LearningPointProgress {
    userId           String
    pointId          Int
    completedEntries String[]   @default([])
    attempts         Json       @default("{}") @db.JsonB
    completedAt      DateTime?  @db.Timestamptz(3)
    xp               Int        @default(0)
    correctAnswers   Int        @default(0)
    user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    point            TrailPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

    @@id([userId, pointId])
    @@index([pointId])
}

model TrailPointContent {
    pointId Int        @id
    blocks  Json       @db.JsonB
    summary String?
    point   TrailPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
}

model LearningActivity {
    id      Int             @id @default(autoincrement())
    pointId Int
    slug    String
    title   String
    point   TrailPoint      @relation(fields: [pointId], references: [id], onDelete: Cascade)
    entries LearningEntry[]

    @@unique([pointId, slug])
}

model LearningEntry {
    activityId Int
    number     Int
    position   Int?
    mode       LearningEntryMode
    type       LearningQuestionType?
    prompt     String?
    media      Json?                 @db.JsonB
    payload    Json?                 @db.JsonB
    answer     Json?                 @db.JsonB
    content    Json?                 @db.JsonB
    activity   LearningActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)

    @@id([activityId, number])
}
